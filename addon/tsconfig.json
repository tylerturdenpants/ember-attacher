{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "experimentalDecorators": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["ember-source/types", "@glint/ember-tsc/types"]
  },
  "glint": {
    "environment": ["ember-template-imports"]
  },
  "include": ["src/**/*.ts", "src/**/*.gts"]
}
