{{~#unless this.renderFloatingElement~}}<meta hidden {{this.parentFinder}} {{this.targetDidUpdate this.hideOn this.showOn @explicitTarget}} {{this.isShownDidUpdate this.isShown}}/>{{~/unless~}}{{~#if this.renderFloatingElement~}}<this.MaybeInElement @destinationElement={{this._floatingElementContainer}} @renderInPlace={{this._renderInPlace}}><div
      class="ember-attacher"
      id={{this.id}}
      role={{@ariaRole}}
      {{this.setupFloatingElement}}
      {{this.targetDidUpdate this.hideOn this.showOn @explicitTarget}}
      {{this.isShownDidUpdate this.isShown}}
      {{this.optionsDidUpdate this.autoUpdate this.animation this.arrow this.useCapture this.placement this.strategy this._renderInPlace this._middleware}}
      ...attributes
    >
      {{#if this.shouldRenderFloatingElement}}
        <div class={{this._class}} style={{this._style}}>
          {{yield (hash hide=this.hide setReference=this.setReference reference=this.reference)}}
          {{#if this.arrow}}
            <div class="ember-attacher-arrow" x-arrow {{this.insertArrow}}></div>
          {{/if}}
          {{#if this.isFillAnimation}}
            <div x-circle></div>
          {{/if}}
        </div>
      {{/if}}
    </div></this.MaybeInElement>{{~/if~}}
