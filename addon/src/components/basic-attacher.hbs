{{~#unless this.renderFloatingElement~}}<meta hidden {{this.parentFinder}} {{this.isShownDidUpdate this.isShown}}/>{{~/unless~}}{{~#if this.renderFloatingElement~}}<this.MaybeInElement @destinationElement={{this._floatingElementContainer}} @renderInPlace={{this._renderInPlace}}><div
      class="ember-attacher"
      id={{this.id}}
      role={{@ariaRole}}
      {{this.setupFloatingElement}}
      {{this.isShownDidUpdate this.isShown}}
      {{this.targetDidUpdate this.hideOn this.showOn @explicitTarget}}
      {{this.optionsDidUpdate this.autoUpdate this.animation this.arrow this.useCapture this.placement this._renderInPlace this._middleware}}
      ...attributes
    >
      <div class={{this._class}} style={{this._style}}>
        {{yield (hash hide=this.hide)}}
        {{#if this.arrow}}
          <div x-arrow {{this.insertArrow}}></div>
        {{/if}}
        {{#if this.isFillAnimation}}
          <div x-circle style="{{this._circleTransitionDuration}}"></div>
        {{/if}}
      </div>
    </div></this.MaybeInElement>{{~/if~}}
