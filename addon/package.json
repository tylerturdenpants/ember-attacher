{
  "name": "ember-attacher",
  "version": "5.0.0",
  "description": "Tooltips and popovers for Ember.js apps",
  "keywords": [
    "ember-addon",
    "tooltips",
    "popovers"
  ],
  "scripts": {
    "build": "rollup --config rollup.config.mjs",
    "prepack": "pnpm run build",
    "prepare": "pnpm run build",
    "start": "rollup --config rollup.config.mjs --watch",
    "lint": "eslint .",
    "typecheck": "ember-tsc --noEmit"
  },
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "test-support": [
        "./dist/test-support/index.d.ts"
      ],
      "template-registry": [
        "./dist/template-registry.d.ts"
      ],
      "*": [
        "./dist/*",
        "./dist/*.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./test-support": {
      "types": "./dist/test-support/index.d.ts",
      "default": "./dist/test-support/index.js"
    },
    "./template-registry": {
      "types": "./dist/template-registry.d.ts"
    },
    "./addon-main.js": "./addon-main.js",
    "./styles": "./dist/styles/ember-attacher.css",
    "./*.js": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*"
    }
  },
  "files": [
    "addon-main.js",
    "dist",
    "README.md"
  ],
  "sideEffects": [
    "./dist/styles/*.css"
  ],
  "repository": "https://github.com/tylerturdenpants/ember-attacher",
  "license": "MIT",
  "author": {
    "name": "Kyle Bishop",
    "email": "kybishop@gmail.com",
    "url": "http://kybishop.com"
  },
  "directories": {
    "doc": "doc",
    "test": "tests"
  },
  "dependencies": {
    "@ember/test-waiters": "^3.1.0 || ^4.0.0",
    "@embroider/addon-shim": "^1.11.0",
    "@floating-ui/dom": "^1.8.0",
    "ember-modifier": "^4.2.2"
  },
  "peerDependencies": {
    "@glimmer/component": "^1.0.0 || ^2.0.0"
  },
  "engines": {
    "node": ">= 20"
  },
  "ember": {
    "edition": "octane"
  },
  "ember-addon": {
    "main": "addon-main.js",
    "type": "addon",
    "version": 2,
    "demoURL": "https://tylerturdenpants.github.io/ember-attacher/",
    "implicit-styles": [
      "./dist/styles/ember-attacher.css"
    ],
    "app-js": {
      "./components/attach-popover.js": "./dist/_app_/components/attach-popover.js",
      "./components/attach-tooltip.js": "./dist/_app_/components/attach-tooltip.js",
      "./components/attacher.js": "./dist/_app_/components/attacher.js",
      "./modifiers/tooltip.js": "./dist/_app_/modifiers/tooltip.js"
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org"
  },
  "devDependencies": {
    "@babel/core": "^7.29.13",
    "@babel/eslint-parser": "^7.29.13",
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@babel/plugin-transform-class-properties": "^8.0.1",
    "@babel/plugin-transform-class-static-block": "^8.1.2",
    "@babel/plugin-transform-typescript": "^7.29.9",
    "@embroider/addon-dev": "^8.5.0",
    "@glimmer/component": "^2.2.1",
    "@glimmer/tracking": "^1.1.2",
    "@glint/ember-tsc": "^1.14.4",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "babel-plugin-ember-template-compilation": "^4.0.1",
    "ember-source": "~7.4.1",
    "eslint": "~9.39.5",
    "eslint-plugin-decorator-position": "^6.1.1",
    "eslint-plugin-ember": "^13.11.2",
    "eslint-plugin-n": "^18.5.0",
    "globals": "^17.14.0",
    "lightningcss": "^1.33.0",
    "rollup": "^4.68.7",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.73.0"
  }
}
